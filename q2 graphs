library(dplyr)
library(ggplot2)
library(ggthemes)

# Read and join data
data <- read.csv("youth-not-in-education-employment-training.csv")
country <- read.csv("continents-according-to-our-world-in-data.csv")
data1 <- data %>% left_join(country, join_by(Code))
data1 <- data1 %>% select(-Entity.y, -Year.y)

# Calculate average proportion by continent and year
data2 <- data1 %>%
  group_by(Continent, Year.x) %>%
  summarise(avg = mean(Share.of.youth.not.in.education..employment.or.training..total....of.youth.population., na.rm = TRUE),.groups = "drop") %>%
  filter(Continent %in% c("Africa", "Asia", "Europe", "North America", "Oceania", "South America"),
         Year.x >= 2015, Year.x <= 2020)

# Plot all continents together
ggplot(data2, aes(x = Year.x, y = avg, color = Continent)) +
  geom_point(size = 2, alpha = 0.8) +
  geom_line(size = 1) +
  scale_color_brewer(palette = "Dark2") +
  labs(
    title = "Youth Not in Employment, Education, or Training (NEET) by Continent (2015-2020)",
    subtitle = "Average proportion of youth (in %) by continent, 2015-2020",
    x = "Year",
    y = "Proportion of NEET Youth (%)",
    color = "Continent"
  ) +
  scale_x_continuous(breaks = seq(2015, 2020, 1)) +
  theme_minimal(base_size = 14) +
  theme(
    plot.title = element_text(face = "bold", size = 18, hjust = 0.5),
    plot.subtitle = element_text(size = 14, hjust = 0.5),
    axis.title = element_text(face = "bold"),
    legend.position = "bottom",
    panel.grid.minor = element_blank(),
    panel.grid.major = element_line(color = "grey85")
  )
