### Helper functions
not_inches <- function(x, smallest = 50, tallest = 84){
  inches <- suppressWarnings(as.numeric(x))
  is.na(inches) | inches < smallest | inches > tallest
}
not_inches(40)
not_inches(77)


not_inches_or_cm <- function(x, smallest = 50, tallest = 84){
  inches <- suppressWarnings(as,numeric(x))
  ind <- !is.na(inches) &
    ((inches) >= smallest & inches <= tallest) |
    (inches/2.54 >= smallest & inches/2.54 <= tallest)
!ind
}
not_inches(50)
not_inches((50*2.54)/2.54)


words_to_numbers <- function(s){
  s <- str_to_lower(s)
  for(i in 0:11){
    s <- str_replace_all(s, words(i), as.character(i))
  }
  s
}
words_to_numbers("five")
words_to_numbers("ten")


convert_format <- function(s){
  s %>%
     # Replace any word representing "feet" with a standard apostrophe
    str_replace("feet|foot|ft", "'") %>%
    
    # Remove any symbols or words representing inches or other noise:
    # "inches", "in", double quotes, '', "cm", "and"
    str_replace_all("inches|in|''|\"|cm|and", "") %>%
    
    # Convert formats like "5 11", "6,2", "5. 9" into "5'11", "6'2", etc.
    # str_replace("^([4-7])\\s*[,\\.\\s+]\\s*(\\d*)$", "\\1'\\2") %>%
    
    str_replace("^([4-7])\\s*[,\\.\\s+]\\s*(\\d*)$", "\\1'\\2") %>%
    
    # If the entry is only "5" or "6" (with or w/o apostrophe), assume "5'0" or "6'0"
    str_replace("^([56])'?$", "\\1'0") %>%
    
    # Convert comma-based decimals (e.g. "1,70") into proper decimal format ("1.70")
    str_replace("^([12])\\s*,\\s*(\\d*)$", "\\1\\.\\2") %>%
    
    # Remove extra whitespace at the beginning/end of the string
    str_trim()
}
convert_format("5,6")


