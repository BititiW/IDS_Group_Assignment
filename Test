### Essential Stringr Functions
str_replace(string = "5ft8", pattern = "ft", replacement = "'")

str_replace_all(string = "between 5ft8 and 5ft10", pattern = "ft", replacement = "'")

str_detect(string = "5'11", pattern = "^[4-7]'[0-9]{1,2}$") # it would be false if there were at least one condition was not met
# ^ means start of the string
#[4-7] matches one digit between 4 and 7
# ' matches the literal apostrophe
# [0-9]{1,2} matches one or two digits from 0 to 9
# $ means end of the string

str_trim(" 5'11 ") # removes leading/trailing spaces but NOT spaces within the string itself

str_to_lower("Five Feet Eight Inches") # (and _upper, _title)


### Regez patterns you MUST KNOW

## Digits
